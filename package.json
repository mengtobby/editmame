    "test": "vitest run",
    "test:watch": "vitest",
    "signaling": "tsx server/signaling-server.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "fractional-indexing": "^3.2.0",
    "mp4box": "^0.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yjs": "^13.6.20",
    "y-protocols": "^1.0.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "tsx": "^4.19.2"
  }
