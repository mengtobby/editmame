{
  "name": "loomp2p",
  "private": true,
  "version": "0.1.0",
  "description": "LoomP2P — local-first, peer-to-peer collaborative non-linear video editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
